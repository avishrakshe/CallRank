    "postinstall": "pnpm --filter @callrank/db run db:generate"
  },
  "devDependencies": {
    "dotenv": "^16.4.7",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  },
  "packageManager": "pnpm@11.25.0"
}
